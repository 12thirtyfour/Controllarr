# This file is owned by the controllarr package, DO NOT MODIFY MANUALLY
# Instead use 'dpkg-reconfigure -plow controllarr' to modify User/Group/UMask/-data
# Or use systemd built-in override functionality using 'systemctl edit controllarr'
[Unit]
Description=Controllarr Daemon
After=network.target

[Service]
User=controllarr
Group=controllarr
UMask=002

Type=simple
ExecStart=/opt/Controllarr/Controllarr -nobrowser -data=/var/lib/controllarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
